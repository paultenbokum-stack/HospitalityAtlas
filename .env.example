# Copy to .env.local for local dev.
DATABASE_URL=postgresql://atlas:atlas_dev@localhost:5433/atlas

# openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Web application). Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# First superadmin — allowed to sign in without an invite.
ROOT_ADMIN_EMAIL=

# Local only: email sign-in for seeded users (admin@dev.local, rep@dev.local, security-rep@dev.local).
DEV_LOGIN=1
SEED_DEV=1

# Server-side Places API (New) key — restrict to the Places API; never exposed to the browser.
GOOGLE_PLACES_API_KEY=
# Browser Maps JavaScript API key — restrict by HTTP referrer. Optional: without it Discover shows a list only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
